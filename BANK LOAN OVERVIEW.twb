      <aliases enabled='yes' />
      <column caption='Total Loan Applications' datatype='integer' name='[Calculation_970807207833047040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([id])' />
      </column>
      <column caption='MTD Loan Applications' datatype='integer' name='[Calculation_970807207834193921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF  &#13;&#10;DATEDIFF(&apos;month&apos;, [issue_date], {MAX([issue_date])})= 0&#13;&#10;THEN &#13;&#10;[id]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='PMTD Loan Applicatioons' datatype='integer' name='[Calculation_970807207840403458]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF &#13;&#10;DATEDIFF(&apos;month&apos;, [issue_date], {MAX([issue_date])})= 1&#13;&#10;THEN&#13;&#10;[id]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='MOM Loan Applications' datatype='real' name='[Calculation_970807207842045956]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_970807207834193921] - [Calculation_970807207840403458]) / &#13;&#10;[Calculation_970807207840403458]' />
      </column>
      <column caption='Total Funded Amount' datatype='integer' name='[Calculation_970807207843450885]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([loan_amount])' />
      </column>
      <column caption='MOM Total Funded Amount' datatype='real' name='[Calculation_970807207851241482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([MTD Loan Applications (copy)_970807207849140232] - [MTD Total Funded Amount (copy)_970807207850995721])/&#13;&#10;[MTD Total Funded Amount (copy)_970807207850995721]' />
      </column>
      <column caption='Total Amount Received' datatype='integer' name='[Calculation_970807207852257291]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_payment])' />
      </column>
      <column caption='MOM Amount Received' datatype='real' name='[Calculation_970807207854120974]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([MTD Total Funded Amount (copy)_970807207853379596] - [MTD Total Amount Received (copy)_970807207853969421]) /&#13;&#10;[MTD Total Amount Received (copy)_970807207853969421]' />
      </column>
      <column caption='Avg Int Rate' datatype='real' name='[Calculation_970807207854690319]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([int_rate])' />
      </column>
      <column caption='MOM Avg Int Rate' datatype='real' name='[Calculation_970807207861391378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([MTD Loan Applications (copy)_970807207855218704]- [MTD Avg Int Rate (copy)_970807207860543505])/&#13;&#10;[MTD Avg Int Rate (copy)_970807207860543505]' />
      </column>
      <column caption='Avg DTI' datatype='real' name='[Calculation_970807207864762387]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([dti])' />
      </column>
      <column caption='MOM AVg DTI' datatype='real' name='[Calculation_970807207865933846]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([MTD Avg Int Rate (copy)_970807207865188372]-[MTD Avg DTI (copy)_970807207865802773])/[MTD Avg DTI (copy)_970807207865802773]' />
      </column>
      <column caption='Good Loan %' datatype='real' name='[Calculation_970807207890685977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF  [Good vs Bad Loan] = &apos;Good Loan&apos; THEN [id] END)/&#13;&#10;COUNT([id])' />
      </column>
      <column caption='Dynamic Measure' datatype='integer' name='[Calculation_970807207893581850]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#13;&#10;[Parameters].[Parameter 1] = &apos;Total Loan Applications&apos; THEN&#13;&#10; [Calculation_970807207833047040]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Total Funded Amount&apos; THEN &#13;&#10;[Calculation_970807207843450885]&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &apos;Total Amount Received&apos; THEN&#13;&#10;[Calculation_970807207852257291]&#13;&#10;END' />
      </column>
      <column datatype='string' name='[Good vs Bad Loan]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[loan_status]' new-bin='true'>
          <bin default-name='false' value='&quot;Bad Loan&quot;'>
            <value>&quot;Charged Off&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Good Loan&quot;'>
            <value>&quot;Current&quot;</value>
            <value>&quot;Fully Paid&quot;</value>
          </bin>
        </calculation>
      </column>
      <column caption='PMTD Avg DTI ' datatype='real' name='[MTD Avg DTI (copy)_970807207865802773]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF  &#13;&#10;DATEDIFF(&apos;month&apos;, [issue_date], {MAX([issue_date])})= 1&#13;&#10;THEN &#13;&#10;[dti]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='PMTD Avg Int Rate' datatype='real' name='[MTD Avg Int Rate (copy)_970807207860543505]' role='measure' type='quantitative'>
